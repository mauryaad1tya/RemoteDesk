# RemoteDesk Configuration

# -----------------
# API Service
# -----------------
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-very-long-and-secure-random-secret-key-min-32-chars
COOKIE_SECRET=replace-with-another-secure-random-secret-key
DATABASE_PATH=./data/remotedesk.db
UPLOAD_DIR=./data/uploads
SCREENSHOT_DIR=./data/screenshots

# Initial Setup / Admin credentials (used by seed script)
INITIAL_ADMIN_EMAIL=admin@remotedesk.local
INITIAL_ADMIN_PASSWORD=RemoteDesk@Admin2025!

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------
# Windows Agent
# -----------------
AGENT_API_URL=http://localhost:4000
AGENT_DEVICE_ID=
AGENT_ENROLLMENT_TOKEN=
AGENT_SECRET_KEY=
AGENT_METRIC_INTERVAL_MS=5000
AGENT_HEARTBEAT_INTERVAL_MS=10000
AGENT_PERMITTED_ROOTS=C:\Users,D:\
AGENT_DATA_DIR=./data/agent

# -----------------
# Web Frontend
# -----------------
VITE_API_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000
